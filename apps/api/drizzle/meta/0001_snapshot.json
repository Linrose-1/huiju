      "checkConstraint": {
        "activities_time_order_ck": {
          "name": "activities_time_order_ck",
          "value": "`activities`.`ends_at` > `activities`.`starts_at`"
        },
        "activities_registration_deadline_ck": {
          "name": "activities_registration_deadline_ck",
          "value": "`activities`.`registration_deadline` is null or `activities`.`registration_deadline` <= `activities`.`starts_at`"
        },
        "activities_capacity_ck": {
          "name": "activities_capacity_ck",
          "value": "`activities`.`capacity` is null or `activities`.`capacity` > 0"
        },
        "activities_active_count_ck": {
          "name": "activities_active_count_ck",
          "value": "`activities`.`active_registration_count` >= 0 and (`activities`.`capacity` is null or `activities`.`active_registration_count` <= `activities`.`capacity`)"
        },
        "activities_fee_ck": {
          "name": "activities_fee_ck",
          "value": "(`activities`.`fee_type` = 'free' and `activities`.`fee_amount_cents` is null) or (`activities`.`fee_type` = 'paid' and `activities`.`fee_amount_cents` is not null and `activities`.`fee_amount_cents` > 0)"
        },
        "activities_cancellation_ck": {
          "name": "activities_cancellation_ck",
          "value": "(`activities`.`lifecycle` = 'cancelled' and `activities`.`cancelled_at` is not null and `activities`.`cancellation_reason` is not null and `activities`.`cancellation_registration_count` is not null) or (`activities`.`lifecycle` <> 'cancelled' and `activities`.`cancellation_registration_count` is null)"
        }
      }
