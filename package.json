{
  "name": "huiju",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:miniapp": "pnpm --filter @huiju/miniapp dev",
    "dev:admin": "pnpm --filter @huiju/admin dev",
    "dev:api": "pnpm --filter @huiju/api dev",
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "api:generate": "pnpm --filter @huiju/api build && node apps/api/scripts/export-openapi.mjs && openapi-typescript docs/api/openapi.json -o packages/api-client/src/generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
